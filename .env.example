# Neo4j Graph Database Configuration
NEO4J__URI=bolt://localhost:7687
NEO4J__USERNAME=neo4j
NEO4J__PASSWORD=graphrag_password
NEO4J__DATABASE=neo4j
NEO4J__MAX_CONNECTION_POOL_SIZE=50
NEO4J__USE_MOCK_IF_UNAVAILABLE=true

# Pinecone Vector Store Configuration
PINECONE__API_KEY=your_pinecone_api_key_here
PINECONE__ENVIRONMENT=us-east-1
PINECONE__INDEX_NAME=graphrag-index
PINECONE__DIMENSION=768
PINECONE__METRIC=cosine
PINECONE__USE_MOCK_IF_UNAVAILABLE=true

# Embedding & Transformer Configuration
EMBEDDING__MODEL_NAME=sentence-transformers/all-mpnet-base-v2
EMBEDDING__DIMENSION=768
EMBEDDING__BATCH_SIZE=64
EMBEDDING__CACHE_SIZE=10000

# Retrieval & Latency SLA Configuration
RETRIEVAL__TOP_K_VECTOR=5
RETRIEVAL__TOP_K_GRAPH_ENTITIES=5
RETRIEVAL__GRAPH_HOP_DEPTH=2
RETRIEVAL__TOP_K_FINAL=5
RETRIEVAL__RRF_K=60
RETRIEVAL__VECTOR_WEIGHT=0.55
RETRIEVAL__GRAPH_WEIGHT=0.45
RETRIEVAL__LATENCY_BUDGET_MS=400.0

# Ingestion Pipeline Tuning
INGESTION__NUM_WORKERS=4
INGESTION__CHUNK_SIZE=384
INGESTION__CHUNK_OVERLAP=64
INGESTION__ENABLE_OCR_FALLBACK=true
